<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Foldout text="Usage Info" name="UsageInfo" value="false">
        <ui:Label text="Saves extra info about whether this spawner was despawned or killed. If the spawned object was despawned during a SavePoint, it will not be spawned in when loading that save point.&#10;&#10;Example 1: Put this script on all Ammo spawners to save which ammo boxes have already been collected.&#10;&#10;Example 2: Single-spawn NPCs that you don&apos;t want to respawn if they have already been killed. Do NOT use on spawners in Encounters" display-tooltip-when-elided="true" style="white-space: normal;" />
    </ui:Foldout>
    <ui:VisualElement style="height: 10px;" />
    <uie:PropertyField binding-path="crateSpawner" name="crateSpawnerProp" />
    <uie:PropertyField binding-path="uniqueID" label="Unique ID" name="uniqueIdProp" />
    <ui:Button text="Reset Fields" display-tooltip-when-elided="true" name="ResetButton" />
</ui:UXML>
